.tabbar-root {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 10rpx 16rpx calc(env(safe-area-inset-bottom) + 10rpx);
  background: transparent;
  z-index: 999;
  box-sizing: border-box;
  pointer-events: none;
}

.tabbar-shell {
  position: relative;
  height: 130rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(91, 113, 109, 0.42);
  background: linear-gradient(180deg, rgba(16, 24, 24, 0.98) 0%, rgba(10, 14, 15, 0.98) 100%);
  display: flex;
  align-items: stretch;
  box-shadow: 0 -2rpx 28rpx rgba(4, 8, 8, 0.55);
  overflow: hidden;
  pointer-events: auto;
}

.top-glow {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 0;
  height: 4rpx;
  background: linear-gradient(90deg, rgba(138, 202, 51, 0) 0%, rgba(170, 236, 68, 0.82) 50%, rgba(138, 202, 51, 0) 100%);
}

.tab-item {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8f9b98;
  transition: color 0.2s ease, transform 0.2s ease;
}

.icon-wrap {
  width: 52rpx;
  height: 52rpx;
  position: relative;
}

.icon-badge {
  position: absolute;
  inset: 0;
  border-radius: 18rpx;
  background: radial-gradient(circle at 30% 28%, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02) 55%, rgba(0, 0, 0, 0.08) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  opacity: 0.9;
}

.icon {
  width: 52rpx;
  height: 52rpx;
  position: relative;
  color: currentColor;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 700;
}

.tab-item.active {
  color: #c7ee5a;
  text-shadow: 0 0 8rpx rgba(187, 237, 91, 0.62);
  transform: translateY(-1rpx);
}

.tab-item.active .icon-badge {
  background: radial-gradient(circle at 30% 28%, rgba(199, 238, 90, 0.4), rgba(199, 238, 90, 0.16) 56%, rgba(199, 238, 90, 0.05) 100%);
  border-color: rgba(199, 238, 90, 0.22);
  box-shadow: 0 0 18rpx rgba(199, 238, 90, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.tab-item.active .icon-wrap {
  filter: drop-shadow(0 0 10rpx rgba(181, 241, 74, 0.72));
}

.tab-dot {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #c7ee5a;
  box-shadow: 0 0 10rpx rgba(181, 241, 74, 0.95);
}

.home-roof {
  position: absolute;
  left: 11rpx;
  top: 6rpx;
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
  border-top-left-radius: 4rpx;
}

.home-body {
  position: absolute;
  left: 11rpx;
  top: 18rpx;
  width: 24rpx;
  height: 20rpx;
  border: 4rpx solid currentColor;
  border-top: none;
  border-bottom-left-radius: 4rpx;
  border-bottom-right-radius: 4rpx;
}

.home-door {
  position: absolute;
  left: 22rpx;
  top: 25rpx;
  width: 6rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-top-left-radius: 3rpx;
  border-top-right-radius: 3rpx;
}

.plan-cover {
  position: absolute;
  left: 9rpx;
  top: 9rpx;
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid currentColor;
  border-radius: 7rpx;
  box-shadow: inset 0 0 0 1rpx rgba(199, 238, 90, 0.12);
}

.plan-ring {
  position: absolute;
  top: 5rpx;
  width: 5rpx;
  height: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
}

.plan-ring-left {
  left: 14rpx;
}

.plan-ring-right {
  right: 14rpx;
}

.plan-line {
  position: absolute;
  left: 13rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 999rpx;
}

.plan-line-1 {
  top: 19rpx;
  width: 18rpx;
}

.plan-line-2 {
  top: 26rpx;
  width: 15rpx;
}

.plan-line-3 {
  top: 33rpx;
  width: 19rpx;
}

.race-flag-pole {
  position: absolute;
  left: 11rpx;
  top: 8rpx;
  width: 3rpx;
  height: 28rpx;
  background: currentColor;
  border-radius: 999rpx;
}

.race-flag {
  position: absolute;
  left: 14rpx;
  top: 8rpx;
  width: 19rpx;
  height: 13rpx;
  background: currentColor;
  border-radius: 2rpx;
  transform: skewX(-14deg);
}

.race-flag-cut {
  position: absolute;
  left: 19rpx;
  top: 15rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: rgba(16, 21, 19, 0.95);
}

.race-finish-dot {
  position: absolute;
  right: 11rpx;
  bottom: 8rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 8rpx rgba(199, 238, 90, 0.75);
}

.profile-head {
  position: absolute;
  left: 16rpx;
  top: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.profile-shoulders {
  position: absolute;
  left: 9rpx;
  top: 23rpx;
  width: 28rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-top-left-radius: 18rpx;
  border-top-right-radius: 18rpx;
  border-bottom: none;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.04);
}
