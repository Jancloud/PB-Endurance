<view class="container home-page">
  <view class="home-backdrop"></view>

  <view class="weather-summary card weather-risk-{{weather.riskLevel}}" wx:if="{{weather}}">
    <view class="weather-summary-head">
      <view class="weather-summary-city">{{weather.city || '当前城市'}} · {{weather.weatherText}}</view>
      <view class="weather-risk-tag weather-risk-tag-{{weather.riskLevel}}">{{weather.riskTag}}</view>
    </view>
    <view class="weather-metrics-row">
      <view class="weather-icon">{{weather.weatherIcon}}</view>
      <view class="weather-summary-temp">{{weather.temperature}}°</view>
      <view class="weather-humidity">
        <text class="weather-drop">●</text>
        <text>湿度 {{weather.humidity}}%</text>
      </view>
      <view class="weather-dew-point" wx:if="{{weather.dewPoint !== null && weather.dewPoint !== undefined}}">
        露点 {{weather.dewPoint}}°
      </view>
    </view>
    <view class="weather-summary-tip">{{weather.tip}}</view>
  </view>

  <view class="card today-hero-card">
    <view class="today-hero-head">
      <view>
        <view class="section-eyebrow">今日核心训练</view>
        <view class="today-title">{{hasTodaySession ? todaySessionTypeText : '训练提醒'}}</view>
      </view>
      <view class="today-status {{todayCompleted ? 'today-status-done' : ''}}" wx:if="{{hasTodaySession}}">
        {{todayCompleted ? '已完成' : '待打卡'}}
      </view>
    </view>

    <block wx:if="{{hasTodaySession}}">
      <view class="today-desc">{{todaySessionDescText}}</view>
      <view class="today-meta">{{heroSubText}} · {{heroWeekText}} · {{heroDoneText}}</view>

      <view class="hero-progress-row">
        <view class="hero-progress-track">
          <view class="hero-progress-fill" style="width: {{progressBarWidth}};"></view>
        </view>
        <view class="hero-progress-rate">{{heroMainText}}</view>
      </view>

      <view class="today-big-metrics">
        <view class="today-big-metric">
          <text class="today-big-number">{{todayDistanceNumber}}</text>
          <text class="today-big-unit">{{todayDistanceUnit}}</text>
        </view>
        <view class="today-big-metric pace-metric">
          <text class="today-big-number pace-number">{{todayPaceText}}</text>
          <text class="today-big-unit">/km</text>
        </view>
      </view>

      <view class="today-action-row" wx:if="{{!todayCompleted}}">
        <button class="btn-primary action-btn today-main-action" bindtap="toggleTodayTask">完成打卡</button>
        <view class="today-secondary-action" bindtap="goToPlan">查看计划</view>
      </view>

      <view class="today-action-row completed-action-row" wx:else>
        <view class="training-done-badge">
          <view class="training-done-dot"></view>
          <text>今日训练已达标</text>
        </view>
        <view class="today-secondary-action" bindtap="goToPlan">查看计划</view>
        <view class="cancel-checkin-link" bindtap="toggleTodayTask">取消打卡</view>
      </view>
    </block>

    <block wx:elif="{{hasTodayMessage}}">
      <view class="empty-text">{{todayTask.message}}</view>
      <view class="today-action-row">
        <view class="today-secondary-action wide-secondary-action" bindtap="goToPlan">查看计划</view>
      </view>
    </block>

    <block wx:else>
      <view class="empty-text">请先在“计划”页选择训练计划。</view>
      <view class="today-action-row">
        <view class="today-secondary-action wide-secondary-action" bindtap="goToPlan">去选择计划</view>
      </view>
    </block>
  </view>

  <view class="card week-overview-card" wx:if="{{hasWeekOverview}}">
    <view class="week-overview-head">
      <view>
        <view class="card-heading">本周训练概览</view>
        <view class="card-subheading">{{weekOverview.phase}} · 计划 {{weekOverview.weeklyKmText}}</view>
      </view>
      <view class="week-status-pill">{{weekOverview.completedText}}</view>
    </view>
    <view class="week-overview-body">
      <view class="week-main-stat">
        <text class="week-km-number">{{weekOverview.plannedKmText}}</text>
        <text class="week-km-unit">km</text>
      </view>
      <view class="week-side-stat">
        <view class="week-side-line">{{weekOverview.runCountText}}</view>
        <view class="week-side-line muted-line">{{weekOverview.title}}</view>
      </view>
        <view class="week-bars">
        <view class="week-bar-item" wx:for="{{weekOverview.bars}}" wx:key="label">
          <view class="week-bar {{item.className}}" style="height: {{item.height}};"></view>
          <view class="week-bar-label">{{item.shortLabel}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card race-mini-card" wx:if="{{hasRaceHint}}" bindtap="goToRace">
    <view class="race-mini-layout">
      <view class="race-mini-row">
        <view class="race-mini-name">{{raceHintName}}</view>
        <view class="race-days-inline">
          <text class="race-days-number">{{raceHintDaysText}}</text>
          <text class="race-days-label">天</text>
        </view>
      </view>
      <view class="race-mini-row race-mini-bottom-row">
        <view class="card-subheading race-mini-subtitle">{{raceHintSubtitle}}</view>
        <view class="race-mini-action">去赛事 ›</view>
      </view>
    </view>
  </view>

  <view class="card taper-reminder-card" wx:if="{{showTaperReminder}}" bindtap="goToTaperGuide">
    <view class="row">
      <view class="section-title">赛前减量提醒</view>
      <view class="taper-reminder-link">查看指南</view>
    </view>
    <view class="taper-reminder-race">{{taperReminderRaceName}}</view>
    <view class="taper-reminder-text">{{taperReminderText}}</view>
  </view>

  <view class="muted weather-source" wx:if="{{!weather && weatherSourceText}}">{{weatherSourceText}}</view>
</view>
