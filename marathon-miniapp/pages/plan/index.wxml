<view class="container plan-page">
  <view class="card plan-tools-card" bindtap="goToFueler">
    <view class="row">
      <view>
        <view class="tool-kicker">智能备赛工具箱</view>
        <view class="tool-title">PB能量舱</view>
        <view class="tool-sub">配速、补给、撞墙风险模拟推演</view>
      </view>
      <view class="tool-arrow">进入</view>
    </view>
  </view>

  <view class="plan-hero-card">
    <view class="plan-hero-head">
      <view>
        <view class="hero-title">{{activeTemplateName}}</view>
        <view class="hero-subtitle">{{activePlanSummary}}</view>
        <view class="hero-subtitle">起始日期：{{startDate}}</view>
      </view>
      <view class="hero-percent">{{completionPercentText}}</view>
    </view>
    <view class="plan-metrics-row">
      <view class="plan-metric-item">
        <view class="metric-label">周期</view>
        <view class="metric-value-line">
          <text class="metric-number">{{weekCountNumber}}</text>
          <text class="metric-unit">{{weekCountUnit}}</text>
        </view>
      </view>
      <view class="plan-metric-item">
        <view class="metric-label">已完成</view>
        <view class="metric-value-line">
          <text class="metric-number">{{doneCountNumber}}</text>
          <text class="metric-unit">{{doneCountUnit}}</text>
        </view>
      </view>
      <view class="plan-metric-item">
        <view class="metric-label">{{distanceMetricLabel}}</view>
        <view class="metric-value-line">
          <text class="metric-number {{isSummerPlan ? 'metric-number-range' : ''}}">{{totalDistanceNumber}}</text>
          <text class="metric-unit">{{totalDistanceUnit}}</text>
        </view>
      </view>
    </view>
    <view class="progress-wrap">
      <view class="progress-bar" style="width: {{completionBarWidth}};"></view>
    </view>
  </view>

  <view class="card panel-card">
    <view class="section-title">选择训练计划</view>
    <view class="setting-label">项目</view>
    <view class="plan-filter-row">
      <view class="plan-filter {{planEventFilter === option ? 'plan-filter-active' : ''}}" wx:for="{{planEventOptions}}" wx:for-item="option" wx:key="*this" data-value="{{option}}" bindtap="onPlanEventChange">{{option}}</view>
    </view>
    <view class="setting-label plan-filter-label">周期</view>
    <view class="plan-filter-row">
      <view class="plan-filter {{planCycleFilter === option ? 'plan-filter-active' : ''}}" wx:for="{{planCycleOptions}}" wx:for-item="option" wx:key="*this" data-value="{{option}}" bindtap="onPlanCycleChange">{{option}}</view>
    </view>
    <view class="plan-option-list">
      <view class="plan-option {{template.name === activeTemplateName ? 'plan-option-active' : ''}}" wx:for="{{visibleTemplates}}" wx:for-item="template" wx:key="name" data-name="{{template.name}}" bindtap="onTemplateSelect">
        <view class="plan-option-head">
          <view class="plan-option-name">{{template.displayName}}</view>
          <view class="plan-option-check">{{template.name === activeTemplateName ? '已选' : '选择'}}</view>
        </view>
        <view class="plan-option-meta">目标 {{template.targetTimeText}} · 目标配速 {{template.targetPaceText}}</view>
        <view class="plan-option-desc">{{template.cycleText}}</view>
      </view>
    </view>
    <view class="setting-item start-date-setting">
      <view class="setting-label">起始日期</view>
      <picker mode="date" start="{{minStartDate}}" value="{{startDate}}" bindchange="onStartDateChange">
        <view class="picker-box">{{startDate}}</view>
      </picker>
    </view>
    <view wx:if="{{isSummerPlan}}" class="summer-plan-note">
      <view>三阶段月跑量：{{activeMonthlyVolume}}</view>
      <view>适用门槛：{{activeAudience}}</view>
      <view>自测：{{activeTestNote}}</view>
    </view>
    <view class="safety-link" bindtap="showSafetyGuide">查看选课与参赛安全建议 ›</view>
  </view>

  <view class="card panel-card">
    <view class="row taper-head" bindtap="toggleTaperGuide">
      <view>
        <view class="section-title">赛前减量指南</view>
      </view>
      <view class="fold-text">{{taperGuideVisible ? "收起" : "展开"}}</view>
    </view>
    <block wx:if="{{taperGuideVisible}}">
      <view class="taper-dialog">
        <view class="taper-line">1. 核心原则：减总量、保强度、保频率。总跑量降至日常 40%-60%，但保留短距离配速刺激。</view>
        <view class="taper-line">2. 周期建议：半马赛前 7-10 天启动；全马常规赛前 14 天启动，深度疲劳跑者可提前至 21 天。</view>
        <view class="taper-line">3. 关键提醒：减量不是躺平，以腿轻、精神好为标准，宁少勿多，保障赛前最佳状态。</view>
      </view>
    </block>
  </view>

  <view class="card panel-card week-card {{weekItem.isCurrentWeek ? 'week-card-current' : ''}}" wx:for="{{weeks}}" wx:key="week" wx:for-item="weekItem">
    <view class="row week-header" data-week="{{weekItem.week}}" bindtap="toggleWeek">
      <view>
        <view class="week-title">第{{weekItem.week}}周</view>
        <view class="week-subtitle">{{weekItem.phase || "训练周期"}} · {{weekItem.volumeText}}</view>
      </view>
      <view class="row">
        <text wx:if="{{weekItem.isCurrentWeek}}" class="week-tag-current">当前周</text>
        <text wx:elif="{{weekItem.is_deload_week}}" class="week-tag">减量周</text>
        <text class="fold-text">{{activeWeek === weekItem.week ? "收起" : "展开"}}</text>
      </view>
    </view>

    <view wx:if="{{activeWeek === weekItem.week}}" class="session-list">
      <view
        class="session-item {{session.sessionClass}}"
        wx:for="{{weekItem.sessions}}"
        wx:key="day_index"
        wx:for-item="session"
        data-week="{{weekItem.week}}"
        data-dayindex="{{session.day_index}}"
        bindtap="toggleSession"
      >
        <view class="session-main-row">
          <view class="session-day">{{session.day_label}}</view>
          <view class="session-body">
            <view class="session-title">{{session.workout_type || "恢复训练"}}</view>
            <view class="session-desc">{{session.description || session.segment || ""}}</view>
            <view wx:if="{{session.hasSessionMeta}}" class="session-meta">
              <text>{{session.distanceText}}</text>
              <text>{{session.paceText}}</text>
            </view>
          </view>
          <view class="{{session.statusClass}}">{{session.statusText}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
