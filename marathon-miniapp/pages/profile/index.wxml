<view class="container profile-page">
  <view class="profile-hero-card">
    <view class="profile-kicker">个人备赛档案</view>
    <view class="profile-title">{{runnerTitle}}</view>
    <view class="profile-subtitle">{{runnerSubtitle}}</view>
    <view class="profile-meta">{{profileMetaText}}</view>
    <view class="profile-progress-track">
      <view class="profile-progress-fill" style="width: {{completionText}};"></view>
    </view>
  </view>

  <view class="card settings-card">
    <view class="section-title">设置与支持</view>
    <view class="settings-list">
      <view class="settings-item" bindtap="goToAbout">
        <view>
          <view class="settings-title">关于 PB日历</view>
          <view class="settings-desc">产品说明、功能边界与使用建议</view>
        </view>
        <view class="settings-arrow">›</view>
      </view>
      <view class="settings-item settings-item-disabled">
        <view>
          <view class="settings-title">数据备份与恢复</view>
          <view class="settings-desc">暂未开放</view>
        </view>
        <view class="settings-tag">规划中</view>
      </view>
      <view class="settings-item danger-settings-item" bindtap="resetAll">
        <view>
          <view class="settings-title danger-text">重置全部数据</view>
          <view class="settings-desc">清空训练进度与目标赛事</view>
        </view>
        <view class="settings-arrow danger-text">›</view>
      </view>
    </view>
  </view>
</view>
