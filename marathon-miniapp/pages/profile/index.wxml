<view class="container">
  <view class="hero-card hero-accent">
    <view class="hero-title">{{completionText}}</view>
    <view class="hero-subtitle">训练计划完成度 · {{planName}}</view>
    <view class="metrics-row">
      <view class="metric-item">
        <view class="metric-label">已完成天数</view>
        <view class="metric-value">{{completedDaysText}}</view>
      </view>
      <view class="metric-item">
        <view class="metric-label">目标赛事</view>
        <view class="metric-value">{{targetRaceCountText}}</view>
      </view>
    </view>
  </view>

  <view class="card panel-card">
    <view class="section-title">备赛概览</view>
    <view class="stats-grid">
      <view class="stats-item">
        <view class="stats-label">当前计划</view>
        <view class="stats-value">{{planName}}</view>
      </view>
      <view class="stats-item">
        <view class="stats-label">开训日期</view>
        <view class="stats-value">{{planStartDate}}</view>
      </view>
      <view class="stats-item">
        <view class="stats-label">训练完成度</view>
        <view class="stats-value">{{completionText}}</view>
      </view>
      <view class="stats-item">
        <view class="stats-label">目标赛事</view>
        <view class="stats-value">{{targetRaceCountText}}</view>
      </view>
    </view>
  </view>

  <view class="card panel-card">
    <view class="section-title">关于</view>
    <button class="btn-secondary action-btn" bindtap="goToAbout">关于PB日历</button>
  </view>

  <view class="card panel-card">
    <view class="section-title">数据管理</view>
    <button class="btn-danger action-btn" bindtap="resetAll">重置全部数据</button>
  </view>
</view>
